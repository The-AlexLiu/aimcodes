# Public deployment URL. Netlify sets URL automatically in production.
URL=https://aimcodes.com

# Whop server credentials. Never expose these with a VITE_ prefix.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_PRODUCT_ID=
WHOP_WEBHOOK_SECRET=
WHOP_ENVIRONMENT=sandbox

# Whop sandbox is a separate account and API. These values never accept live payments.
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_ACCOUNT_ID=
WHOP_SANDBOX_PRODUCT_ID=
WHOP_SANDBOX_WEBHOOK_SECRET=

# At least 32 random characters. Rotating this invalidates existing access links/cookies.
AIMCODES_ACCESS_SECRET=

# Transactional delivery email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AimCodes <delivery@mail.aimcodes.com>

# Optional server-side purchase measurement. No PII is sent.
GA4_MEASUREMENT_ID=G-2VMCECN5S6
GA4_API_SECRET=
