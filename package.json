    "build": "node scripts/generate-crosshair-images.mjs && vite build && node scripts/generate-localized-routes.mjs",
    "generate:images": "node scripts/generate-crosshair-images.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "validate:crosshairs": "node scripts/validate-crosshairs.mjs",
    "validate:manifest": "node scripts/validate-catalog-manifest.mjs",
    "validate:finder": "node scripts/validate-reaction-ranks.mjs",
    "validate:localization": "node scripts/validate-localization.mjs",
    "validate:routing": "node scripts/validate-localized-routes.mjs",
    "validate:seo": "node scripts/validate-seo-pages.mjs",
    "validate:links": "node scripts/validate-internal-links.mjs",
    "validate:tools": "node scripts/validate-seo-tools.mjs",
    "validate:analytics": "node scripts/validate-analytics.mjs",
    "validate:sharing": "node scripts/validate-sharing.mjs",
    "validate:adsense": "node scripts/validate-adsense-readiness.mjs",
    "validate:images": "node scripts/validate-image-seo.mjs",
    "validate:performance": "node scripts/validate-performance-budget.mjs",
    "social:doctor": "node scripts/social-publishing/cli.mjs doctor",
    "social:setup": "node scripts/social-publishing/cli.mjs setup",
    "social:validate": "node scripts/social-publishing/cli.mjs validate",
    "social:test": "node scripts/social-publishing/self-test.mjs",
    "social:seed-media": "node scripts/social-publishing/seed-public-media.mjs",
    "social:validate-media": "node scripts/social-publishing/validate-public-media.mjs",
    "social:prepare": "node scripts/social-publishing/cli.mjs prepare",
    "social:drafts": "node scripts/social-publishing/cli.mjs drafts",
