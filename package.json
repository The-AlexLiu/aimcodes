    "validate:pro-candidates": "node scripts/validate-pro-crosshair-candidates.mjs",
    "validate:verified-pros": "node scripts/validate-verified-pro-crosshairs.mjs",
    "validate:diff": "node scripts/validate-task-diff.mjs",
    "validate:workflow": "node scripts/validate-development-workflow.mjs",
    "task:context": "node scripts/task-context.mjs",
    "check:auto": "node scripts/run-check-suite.mjs auto",
    "check:quick": "node scripts/run-check-suite.mjs quick",
    "check:data": "node scripts/run-check-suite.mjs data",
    "check:seo": "node scripts/run-check-suite.mjs seo",
    "check:release": "node scripts/run-check-suite.mjs release"
